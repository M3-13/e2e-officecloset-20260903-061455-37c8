# Copy this file to `.env` and export the values before starting the server,
# or set them directly in your shell. The only value with no default is
# JWT_SECRET — generate a strong random secret once and reuse it:
#   python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET=
DATABASE_URL=sqlite:///./wardrobe.db
UPLOAD_DIR=uploads
FRONTEND_ORIGIN=http://localhost:5173
